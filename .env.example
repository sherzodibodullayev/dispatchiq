# Copy to .env and fill in. Never commit .env.

# Required for the copilot. Get one at https://platform.openai.com/api-keys
# The marketing pages work without it; only /api/chat fails, with a 503.
OPENAI_API_KEY=sk-...

CHAT_MODEL=gpt-4.1

# dev | production. In production SESSION_SECRET becomes mandatory.
ENV=dev

# Any long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Comma-separated origins allowed to call /api/*. The browser client is
# same-origin, so leave this empty unless something off-domain must call it.
ALLOWED_ORIGINS=

# Contact details shown in the footer, the demo page and the pricing page.
# These are placeholders in config.py until the real ones exist — set them here
# and no template needs touching.
CONTACT_EMAIL=hello@dispatchiq.com
CONTACT_LINKEDIN=https://www.linkedin.com/in/mukhlisa-latifova-53421143b
CONTACT_INSTAGRAM=https://www.instagram.com/dispatchwithlisa
CONTACT_FACEBOOK=https://www.facebook.com/profile.php?id=61594856372735

# Keep the temporary host out of Google. Flip to true only once the real
# domain is attached and serving.
ALLOW_INDEXING=false

# Redis. Optional on a normal server (conversations and rate limits fall back
# to process memory, single worker only). REQUIRED on serverless — there is no
# shared memory between requests there, so without it every message starts a
# new conversation and the rate limit never accumulates.
#
# Hosted providers hand you one URL; rediss:// carries TLS and the password.
REDIS_URL=

# Only needed for a plain local Redis, when REDIS_URL is empty.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
